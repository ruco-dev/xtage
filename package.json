{
  "name": "@ruco-dev/xtage",
  "version": "0.6.1",
  "description": "Local MCP server giving Claude persistent, semantic knowledge of a codebase",
  "homepage": "https://xtage.ruco.dev",
  "license": "MIT",
  "author": "ruco-dev",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/server.js",
  "bin": {
    "xtage": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruco-dev/xtage.git"
  },
  "bugs": {
    "url": "https://github.com/ruco-dev/xtage/issues"
  },
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "sync-templates": "npx mdblu sync ./templates --templates CODEINDEX.md,REPO.md,PROJECTINSIGHTS.md,GENERALINSIGHTS.md"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "adm-zip": "^0.6.0",
    "ignore": "^6.0.2",
    "mcpster": "^0.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
